<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SalesDemo.Models"
        x:Class="SalesDemo.Views.MainWindow"
        Title="Quản lý Bán hàng"
        Width="1050" Height="680"
        Background="#F5F7FA"
        RequestedThemeVariant="Light">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#16A34A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#1976D2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #22000000" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="#222222" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#123F5D" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="🏪 HỆ THỐNG QUẢN LÝ BÁN HÀNG" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Sẵn sàng" Foreground="#B0C4DE" VerticalAlignment="Center" FontStyle="Italic" />
            </Grid>
        </Border>

        <TabControl Background="Transparent">

            <!-- TAB 1: Sản phẩm -->
            <TabItem Header="📦 Sản phẩm">
                <DockPanel Margin="16">
                    <Border DockPanel.Dock="Top" Background="#123F5D" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🏠 HOMEY STORE" Foreground="White" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Đồ dùng cho không gian sống của bạn" Foreground="#B0C4DE" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="TxtTimKiem" Watermark="🔍 Tìm kiếm sản phẩm..." Width="280"
                                     TextChanged="OnTimKiemThayDoi" />
                            <ComboBox x:Name="CboDanhMuc" Width="200" SelectionChanged="OnDanhMucThayDoi" />
                            <TextBlock x:Name="TxtLoadingSanPham" Text="" VerticalAlignment="Center" Foreground="#888" FontStyle="Italic" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer>
                        <ItemsControl x:Name="ListSanPham">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SanPham">
                                    <Border Classes="card" Width="220" Margin="0,0,12,12" Padding="0">
                                        <StackPanel>
                                            <Panel>
                                               <Image Source="{Binding ProductImage}"
                                                      Width="220"
                                                      Height="150"
                                                      Stretch="Uniform"/>
                                                <Border Background="{Binding SoLuongTon, Converter={x:Static models:StockColorConverter.Instance}}"
                                                        CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                    <TextBlock Text="{Binding TrangThaiTonKho}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </Panel>
                                            <StackPanel Margin="12,10,12,12" Spacing="4">
                                                <TextBlock Text="{Binding TenSP}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Foreground="#222222" />
                                                <TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="16" Foreground="#123F5D" />
                                                <Button Content="{Binding NutThemVaoGioText}" IsEnabled="{Binding ConHang}"
                                                        Tag="{Binding}" Click="OnThemNhanhVaoGio"
                                                        Classes="secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 2: Giỏ hàng -->
            <TabItem Header="🧾 Giỏ hàng / Thanh toán">
                <DockPanel Margin="16">

                    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="👤 Khách hàng:" VerticalAlignment="Center" Width="100" Foreground="#222222" />
                                <ComboBox x:Name="CboKhachHang" Width="220" PlaceholderText="Chọn khách hàng...">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:KhachHang">
                                            <TextBlock Text="{Binding HienThi}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBox x:Name="TxtTenKhachHang" Width="180" Watermark="Tên mới..." />
                                <TextBox x:Name="TxtSoDienThoai" Width="140" Watermark="SĐT mới..." />

                                <TextBlock Text="💳 HTTT:" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#222222" />
                                <ComboBox x:Name="CboHinhThucTT" Width="140" SelectedIndex="0">
                                    <ComboBoxItem Content="Tiền mặt" />
                                    <ComboBoxItem Content="Chuyển khoản" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🛍️ Sản phẩm:" VerticalAlignment="Center" Width="100" Foreground="#222222" />
                                <ComboBox x:Name="CboSanPham" Width="220" PlaceholderText="Chọn sản phẩm..." />
                                <TextBlock Text="Số lượng:" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#222222" />
                                <NumericUpDown x:Name="NumSoLuong" Width="110" Minimum="1" Value="1" />
                                <Button Content="➕ Thêm vào giỏ" Classes="secondary" Click="OnThemVaoGio" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="TxtTongTien" Grid.Column="0" Text="Tạm tính: 0 đ"
                                       VerticalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="#123F5D" />
                            <Button Grid.Column="1" Content="✅ XÁC NHẬN ĐẶT HÀNG" Classes="primary" Click="OnLuuHoaDon" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <ItemsControl x:Name="ListGioHang">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ChiTietHoaDonItem">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding TenSP}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#222222" />
                                            <TextBlock Grid.Column="1" Text="{Binding SoLuong, StringFormat='x{0}'}"
                                                       Foreground="#888" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding DonGia, StringFormat='{}{0:N0} đ'}"
                                                       Foreground="#888" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}"
                                                       FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 3: Đơn hàng -->
            <TabItem Header="📋 Đơn hàng">
                <DockPanel Margin="16">
                    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="📋 Danh sách đơn hàng" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="#123F5D" />
                            <Button Grid.Column="1" Content="🔄 Làm mới" Classes="secondary" Click="OnRefreshDonHang" />
                        </Grid>
                    </Border>
                    <ScrollViewer>
                        <ItemsControl x:Name="ListDonHang">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DonHang">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding SoHD, StringFormat='HD{0:D5}'}"
                                                       FontWeight="Bold" VerticalAlignment="Center" Width="90" Foreground="#222222" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NgayLap, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="#888" FontSize="12" />
                                                <TextBlock Text="{Binding HinhThucThanhToan}" Foreground="#888" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TongTien, StringFormat='{}{0:N0} đ'}"
                                                       FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding TrangThaiHienThi}" VerticalAlignment="Center" Foreground="#222222" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 4: Nhập hàng -->
            <TabItem Header="📦 Nhập hàng">
                <DockPanel Margin="16">
                    <Border Classes="card" DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Spacing="15">
                            <TextBlock Text="📦 NHẬP THÊM HÀNG" FontSize="22" FontWeight="Bold" Foreground="#123F5D" />
                            <TextBlock Text="Chọn sản phẩm và nhập số lượng hàng mới." Foreground="#777777" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Sản phẩm:" VerticalAlignment="Center" Width="90" Foreground="#222222" />
                                <ComboBox x:Name="CboSanPhamNhap" Width="300" PlaceholderText="Chọn sản phẩm..." />
                                <TextBlock Text="Số lượng:" VerticalAlignment="Center" Foreground="#222222" />
                                <NumericUpDown x:Name="NumSoLuongNhap" Width="120" Minimum="1" Value="1" />
                                <Button Content="📥 NHẬP HÀNG" Classes="primary" Click="OnNhapHang" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="📜 Lịch sử nhập hàng (7 ngày gần đây)"
                                       FontSize="18" FontWeight="Bold" Foreground="#123F5D" Margin="0,0,0,10" />

                            <TextBlock x:Name="TxtLichSuTrong" DockPanel.Dock="Top"
                                       Text="Chưa có lượt nhập hàng nào trong 7 ngày qua." Foreground="#888"
                                       IsVisible="False" Margin="0,0,0,8" />

                            <ScrollViewer MaxHeight="380">
                                <ItemsControl x:Name="ListLichSuNhap">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:LichSuNhapHang">
                                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid ColumnDefinitions="140,*,Auto,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding NgayNhapHienThi}"
                                                               Foreground="#888" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TenSP}"
                                                               FontWeight="Bold" Foreground="#222222" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SoLuong, StringFormat='+{0}'}"
                                                               Foreground="#16A34A" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}"
                                                               Foreground="#888" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>