<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SalesDemo.Models"
        x:Class="SalesDemo.Views.MainWindow"
        Title="Quan ly Ban hang"
        Width="1050" Height="680"
        Background="#F5F7FA">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#16A34A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#1976D2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.disabled2">
            <Setter Property="Background" Value="#BDBDBD" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #22000000" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="#123F5D" Padding="20,14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="🛒" FontSize="22" VerticalAlignment="Center" />
                <TextBlock Text="SHOP ONLINE - Demo" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtStatus" Text="" Foreground="#B0C4DE" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
            </StackPanel>
        </Border>

        <TabControl Background="Transparent">

            <!-- TAB 1: San pham -->
            <TabItem Header="📦 San pham">
                <DockPanel Margin="16">

                    <!-- Thanh tim kiem + loc danh muc -->
                    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="TxtTimKiem" Watermark="🔍 Tim kiem san pham..." Width="280"
                                TextChanged="OnTimKiemThayDoi" />
                            <ComboBox x:Name="CboDanhMuc" Width="200" SelectionChanged="OnDanhMucThayDoi" />
                            <Button Content="🔄" Classes="secondary" Click="OnRefreshSanPham" />
                            <TextBlock x:Name="TxtLoadingSanPham" Text="" VerticalAlignment="Center"
                                       Foreground="#888" FontStyle="Italic" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer>
                        <ItemsControl x:Name="ListSanPham">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SanPham">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                                    Background="#E3F2FD" Margin="0,0,14,0">
                                                <TextBlock Text="🏷️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TenSP}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{Binding DonViTinh}" Foreground="#888" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}"
                                                           FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <Border Grid.Column="3" CornerRadius="12" Padding="12,6" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Background="{Binding SoLuongTon, Converter={x:Static models:StockColorConverter.Instance}}">
                                                <TextBlock Text="{Binding TrangThaiTonKho}" Foreground="White" FontWeight="Bold" FontSize="12" />
                                            </Border>
                                        <Button Grid.Column="4" Content="{Binding NutThemVaoGioText}"
                                            Classes="secondary"
                                            IsEnabled="{Binding ConHang}"
                                            Click="OnThemNhanhVaoGio" Tag="{Binding}" />    
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 2: Lap hoa don -->
            <TabItem Header="🧾 Gio hang / Thanh toan">
                <DockPanel Margin="16">

                    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="👤 Khach hang:" VerticalAlignment="Center" Width="110" />
                                <ComboBox x:Name="CboKhachHang" Width="240" />
                                <TextBlock Text="💳 Thanh toan:" VerticalAlignment="Center" Margin="20,0,0,0" Width="100" />
                                <ComboBox x:Name="CboHinhThucTT" Width="150" SelectedIndex="0">
                                    <ComboBoxItem Content="Tien mat" />
                                    <ComboBoxItem Content="Chuyen khoan" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🛍️ San pham:" VerticalAlignment="Center" Width="110" />
                                <ComboBox x:Name="CboSanPham" Width="240" />
                                <TextBlock Text="So luong:" VerticalAlignment="Center" Margin="20,0,0,0" />
                                <NumericUpDown x:Name="NumSoLuong" Width="110" Minimum="1" Value="1" />
                                <Button Content="+ Them vao gio" Classes="secondary" Click="OnThemVaoGio" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="TxtTongTien" Grid.Column="0" Text="Tam tinh: 0 đ"
                                       VerticalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="#123F5D" />
                            <Button Grid.Column="1" Content="✅ XAC NHAN DAT HANG" Classes="primary" Click="OnLuuHoaDon" />
                        </Grid>
                    </Border>

                    <ScrollViewer>
                        <ItemsControl x:Name="ListGioHang">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ChiTietHoaDonItem">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding TenSP}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SoLuong, StringFormat='x{0}'}"
                                                       Foreground="#888" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding DonGia, StringFormat='{}{0:N0} đ'}"
                                                       Foreground="#888" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}"
                                                       FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- TAB 3: Don hang (lich su) -->
            <TabItem Header="📋 Don hang">
                <DockPanel Margin="16">
                    <Button DockPanel.Dock="Top" Content="🔄 Lam moi danh sach" Classes="secondary"
                            Click="OnRefreshDonHang" Margin="0,0,0,12" HorizontalAlignment="Left" />
                    <ScrollViewer>
                        <ItemsControl x:Name="ListDonHang">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DonHang">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding SoHD, StringFormat='HD{0:D5}'}"
                                                       FontWeight="Bold" VerticalAlignment="Center" Width="90" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NgayLap, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="#888" FontSize="12" />
                                                <TextBlock Text="{Binding HinhThucThanhToan}" Foreground="#888" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TongTien, StringFormat='{}{0:N0} đ'}"
                                                       FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center" Margin="10,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding TrangThaiHienThi}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>

</Window>